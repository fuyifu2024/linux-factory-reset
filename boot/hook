#!/bin/sh
set -eu
case "${1:-}" in prereqs) exit 0 ;; esac
[ -f /etc/ubuntu-reset/boot.conf ] || exit 0
. /usr/share/initramfs-tools/hook-functions
mkdir -p "$DESTDIR/conf" "$DESTDIR/usr/lib/ubuntu-reset"
copy_file config /etc/ubuntu-reset/boot.conf /conf/ubuntu-reset.conf
copy_file script /usr/lib/ubuntu-reset/reconcile.sh /usr/lib/ubuntu-reset/reconcile.sh
copy_file script /usr/lib/ubuntu-reset/relocate.sh /usr/lib/ubuntu-reset/relocate.sh
copy_file script /usr/lib/ubuntu-reset/restore.sh /usr/lib/ubuntu-reset/restore.sh
# Do not rely on the distro-specific BusyBox applet whitelist.
for tool in rsync sha256sum du df stat find cat readlink grep sed awk mkdir rm mv sync sleep blkid losetup efibootmgr; do
    # Ubuntu's coreutils alternatives may be absolute links outside the initrd.
    # Copy their actual executable under the applet name, with its shared libraries.
    copy_exec "$(readlink -f "$(command -v "$tool")")" "/usr/lib/ubuntu-reset/bin/$tool"
done
for module in ext4 squashfs loop vfat nls_utf8 nls_ascii nls_cp437 usb_storage uas xhci_pci efivarfs; do
    manual_add_modules "$module"
done
